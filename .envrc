export PATH=./tmp/bin:$PATH

# Azurite開発用設定
export AZURITE_BLOB_PORT=20000
export AZURITE_QUEUE_PORT=20001
export AZURITE_TABLE_PORT=20002
export AZURITE_DATA_PATH=./data/azurite
export AZURITE_CONTAINER_NAME=azurite-dev
export AZURITE_CERT_PATH=./certs/server.pem
export AZURITE_KEY_PATH=./certs/server-key.pem

# Azure設定
export AZURE_RESOURCE_GROUP=azstorage-dev
export AZURE_LOCATION=japaneast
export AZURE_STORAGE_ACCOUNT_NAME=azb$(whoami)
export AZURE_SUBSCRIPTION_ID=$(az account show --query id -o tsv 2>/dev/null || echo "")
export AZURE_TENANT_ID=$(az account show --query tenantId -o tsv 2>/dev/null || echo "")
export AZURE_USER_OBJECT_ID=$(az ad signed-in-user show --query id -o tsv 2>/dev/null || echo "")
